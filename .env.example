# InvoicePilot AI Configuration

# Backend Server
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database & Storage
DATABASE_URL=sqlite:///./storage/invoicepilot.db
STORAGE_DIR=./storage/documents

# Local Ollama AI Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# When MOCK_AI=true, synthetic extraction is used for testing without Ollama
MOCK_AI=false

# OCR Configuration
# If tesseract is not in system PATH, specify its absolute path here, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
